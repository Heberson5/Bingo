# Copie para ".env" (nunca commitado — ver .gitignore) na mesma pasta
# do docker-compose.yml, na VPS, com valores de verdade.

# Senha do usuario/banco do Postgres (so usada internamente, entre os
# containers "api" e "postgres" — nao e exposta pra fora).
POSTGRES_PASSWORD=troque-esta-senha

# Segredos usados para assinar os tokens de login. Gere algo aleatorio,
# por exemplo com: openssl rand -hex 32
JWT_ACCESS_SECRET=troque-este-segredo
JWT_REFRESH_SECRET=troque-este-outro-segredo

# Usuario Master (acesso total) criado automaticamente no primeiro
# deploy — ver api/prisma/seed.js. Depois de criado uma vez, essas
# variaveis podem ficar (o seed nao mexe mais nele, a nao ser que
# SEED_MASTER_FORCE_RESET=true).
SEED_MASTER_EMAIL=hebersohas@gmail.com
SEED_MASTER_PASSWORD=troque-esta-senha
SEED_MASTER_FORCE_RESET=false

# Backup diário criptografado do banco (serviço "backup"). OBRIGATÓRIO
# para o backup funcionar — sem esta senha nenhuma cópia é gravada.
# Guarde-a num lugar seguro FORA da VPS: sem ela não dá para restaurar.
# Gere com: openssl rand -base64 32
BACKUP_PASSPHRASE=
# Quantos dias de cópias manter e a que horas fazer (0-23).
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3

# HTTPS (ver README): domínio do certificado e porta HTTPS na VPS.
BINGO_DOMAIN=bingo.sauberlich.com.br
BINGO_HTTPS_PORT=8443
